# Copy to .env.local and fill in values from Supabase + OpenAI / AI Gateway.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — Freya chat + product knowledge embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# After applying supabase/migrations/20260806120000_freya_knowledge_vectors.sql:
#   npm run knowledge:ingest

# Optional: Vercel AI Gateway (if set, Freya prefers gateway over direct OpenAI)
# AI_GATEWAY_API_KEY=

# Optional: protect cron + inbound stub webhooks
CRON_SECRET=change-me
INBOX_WEBHOOK_SECRET=change-me

# Meta — Facebook / Instagram / Messenger Page OAuth (Settings → Connect with Meta)
META_APP_ID=
META_APP_SECRET=
# Optional Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0
# Optional comma-separated scopes override
# META_OAUTH_SCOPES=

# App URL (local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://app.antarious.com
# Auth email links redirect to: ${NEXT_PUBLIC_APP_URL}/auth/callback
# Meta OAuth callback (add in Meta App → Facebook Login → Valid OAuth Redirect URIs):
#   ${NEXT_PUBLIC_APP_URL}/api/meta/oauth/callback
# Also set Supabase Auth Site URL + redirect allowlist to https://app.antarious.com
# Team invites use Supabase Auth inviteUserByEmail (Auth SMTP — e.g. Resend configured in Supabase).
