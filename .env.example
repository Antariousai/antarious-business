# Copy to .env.local and fill in values from Supabase + OpenAI / AI Gateway.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — either direct key or Vercel AI Gateway
OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional: protect cron + inbound stub webhooks
CRON_SECRET=change-me
INBOX_WEBHOOK_SECRET=change-me

# App URL (local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://freya.antarious.com
# Auth email links redirect to: ${NEXT_PUBLIC_APP_URL}/auth/callback
