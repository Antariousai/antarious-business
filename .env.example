# Copy to .env.local and fill in values from Supabase + OpenAI / AI Gateway.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — Freya chat + product knowledge embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# After applying supabase/migrations/20260806120000_freya_knowledge_vectors.sql:
#   npm run knowledge:ingest

# Optional: Vercel AI Gateway (if set, Freya prefers gateway over direct OpenAI)
# AI_GATEWAY_API_KEY=

# Optional: protect cron + inbound stub webhooks
CRON_SECRET=change-me
INBOX_WEBHOOK_SECRET=change-me

# Meta — Facebook Page OAuth + Instagram Business Login
META_APP_ID=
META_APP_SECRET=
# AES-256 key: 32-byte value as base64, or any passphrase (hashed). Required in production.
META_TOKEN_ENCRYPTION_KEY=
# Must match Meta Developer → Webhooks → Verify Token
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (single source of truth)
# META_GRAPH_API_VERSION=v21.0
# META_GRAPH_VERSION=v21.0
# Optional Facebook Page OAuth scopes override
# META_OAUTH_SCOPES=
# Instagram Business Login scopes override
# META_IG_LOGIN_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_insights
# Set to 0/false to force Instagram connect via Facebook Page OAuth only
# META_IG_LOGIN_ENABLED=1
# Dev only — never in production
# META_WEBHOOK_SKIP_SIGNATURE=1

# App URL (local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://app.antarious.com
# Auth email links redirect to: ${NEXT_PUBLIC_APP_URL}/auth/callback
# Meta OAuth callbacks (add in Meta Developer Dashboard):
#   Facebook Login:  ${NEXT_PUBLIC_APP_URL}/api/meta/oauth/callback
#   Instagram Login: ${NEXT_PUBLIC_APP_URL}/api/meta/instagram/oauth/callback
#   Webhooks:        ${NEXT_PUBLIC_APP_URL}/api/webhooks/meta
# Also set Supabase Auth Site URL + redirect allowlist to https://app.antarious.com
# Team invites use Supabase Auth inviteUserByEmail (Auth SMTP — e.g. Resend configured in Supabase).
