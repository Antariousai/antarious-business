# Copy to .env.local and fill in values from Supabase + OpenAI / AI Gateway.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — Freya chat + product knowledge embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# After applying supabase/migrations/20260806120000_freya_knowledge_vectors.sql:
#   npm run knowledge:ingest

# Optional: Vercel AI Gateway (if set, Freya prefers gateway over direct OpenAI)
# AI_GATEWAY_API_KEY=

# Optional: protect cron + inbound stub webhooks
CRON_SECRET=change-me
INBOX_WEBHOOK_SECRET=change-me

# App URL (local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://freya.antarious.com
# Auth email links redirect to: ${NEXT_PUBLIC_APP_URL}/auth/callback

# Resend — team invite emails (Team → Invite)
# Verify domain freya.antarious.com (or your sending domain) in Resend first.
RESEND_API_KEY=
# Optional override (default: Freya <invites@freya.antarious.com>)
# RESEND_FROM=Freya <invites@freya.antarious.com>
